local SUFFIX = {"", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc"}
local function fmt(n)
	n = tonumber(n) or 0
	if math.abs(n) < 1000 then return tostring(math.floor(n)) end
	local i = math.floor(math.log10(math.abs(n)) / 3)
	if i > #SUFFIX - 1 then i = #SUFFIX - 1 end
	return string.format("%.2f%s", n / (1000 ^ i), SUFFIX[i + 1])
end

local function get_stat(names)
	local ls = LP:FindFirstChild("leaderstats")
	if ls then
		for _, v in ipairs(ls:GetChildren()) do
			if v:IsA("ValueBase") then
				local vl = v.Name:lower()
				for _, n in ipairs(names) do
					if vl:find(n) then return tonumber(v.Value) or 0 end
				end
			end
		end
	end
	for _, n in ipairs(names) do
		local cap = n:sub(1, 1):upper() .. n:sub(2)
		local a = LP:GetAttribute(cap)
		if a then return tonumber(a) or 0 end
	end
	return 0
end

local function is_food(t)
	if not t or not t:IsA("Tool") then return false end
	return t.Name:match("^Food%d*") ~= nil
end

local function scan_tools()
	local foods, animals = {}, {}
	local containers = {LP:FindFirstChild("Backpack"), LP.Character}
	for _, c in ipairs(containers) do
		if c then
			for _, t in ipairs(c:GetChildren()) do
				if t:IsA("Tool") then
					if is_food(t) then table.insert(foods, t)
					else table.insert(animals, t) end
				end
			end
		end
	end
	return foods, animals
end

local function best_food()
	local foods = scan_tools()
	local best, bn = nil, -1
	for _, t in ipairs(foods) do
		local n = tonumber(t.Name:match("%d+")) or 0
		if n > bn then best, bn = t, n end
	end
	return best
end

local function get_income()
	for _, key in ipairs({"MoneyPerSecond", "IncomePerSecond", "Income", "PerSecond", "MoneyRate", "IncomeRate"}) do
		local v = LP:GetAttribute(key)
		if v then return tonumber(v) end
	end
	return nil
end

local function get_boosts()
	local out = {}
	local ok, attrs = pcall(function() return LP:GetAttributes() end)
	if not ok or type(attrs) ~= "table" then return out end
	for k, v in pairs(attrs) do
		local kl = tostring(k):lower()
		local is_boost = kl:find("boost") or kl:find("luck") or kl:find("moneyx") or kl:find("trainx")
		local n = tonumber(v)
		if is_boost and n and n > 1 then
			local short = tostring(k):gsub("Boost", ""):gsub("Multiplier", "")
			table.insert(out, short .. " " .. (n % 1 == 0 and tostring(math.floor(n)) or tostring(n)) .. "x")
		end
	end
	return out
end

local function update()
	pcall(function()
		local money = get_stat({"money", "cash", "coin"})
		local level = get_stat({"level", "lvl", "rank"})
		local inc = get_income()
		local _, animals = scan_tools()
		local food = best_food()

		local incStr = inc and ("  +" .. fmt(inc) .. "/s") or ""
		row1.Text = "$" .. fmt(money) .. incStr .. "   · Lv " .. level
		row2.Text = "balo: " .. #animals .. "   ·   food: " .. (food and food.Name or "none")

		local boosts = get_boosts()
		if #boosts > 0 then
			row3.Text = "boost: " .. table.concat(boosts, " · ")
			row3.TextColor3 = COL.good
		else
			row3.Text = "boost: ko có"
			row3.TextColor3 = COL.dim
		end

		row4.Text = os.date("%H:%M:%S") .. "  ·  live"
	end)
end

minBtn.MouseButton1Click:Connect(function()
	hud.Visible = false
	floatBtn.Visible = true
end)
floatBtn.MouseButton1Click:Connect(function()
	hud.Visible = true
	floatBtn.Visible = false
end)
closeBtn.MouseButton1Click:Connect(function()
	getgenv().linhhub_hud = nil
	gui:Destroy()
end)

local dragging, dragStart, startPos
header.InputBegan:Connect(function(input)
	if not hud.Parent then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = hud.Position
	end
end)
UIS.InputChanged:Connect(function(input)
	if not hud.Parent then return end
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local d = input.Position - dragStart
		hud.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
	end
end)
UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

UIS.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if not hud.Parent then return end
	if input.KeyCode == CONFIG.TOGGLE_KEY or input.KeyCode == CONFIG.TOGGLE_KEY2 then
		if hud.Visible then
			hud.Visible = false
			floatBtn.Visible = true
		else
			hud.Visible = true
			floatBtn.Visible = false
		end
	end
end)

update()
task.spawn(function()
	while hud.Parent do
		task.wait(CONFIG.UPDATE_INTERVAL)
		update()
	end
end)

