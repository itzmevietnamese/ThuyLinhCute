      TextXAlignment = Enum.TextXAlignment.Left,
      Text = "  " .. m .. " · " .. MODE_SHORT[m],
      AutoButtonColor = false,
    })
    mk(b, "UICorner", { CornerRadius = UDim.new(0, 5) })
    b.MouseButton1Click:Connect(function()
      State.throw_mode = m; paint_modes(); log("mode → " .. m)
    end)
    mbtns[m] = b
  end
  paint_modes()

  Ui.mode_desc_label = mk(parent, "TextLabel", {
    Size = UDim2.new(1, 0, 0, 24),
    Position = UDim2.new(0, 0, 0, y + 7 * 30 + 10),
