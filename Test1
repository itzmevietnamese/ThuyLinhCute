local function make_button(parent, props)
  local b = mk(parent, "TextButton", {
    BackgroundColor3 = props.bg or TH.panel_alt,
    BorderSizePixel = 0,
    Font = props.font or FONT_B,
    TextSize = props.size or 11,
    TextColor3 = props.color or TH.text,
    Text = props.text or "",
    AutoButtonColor = false,
    Size = props.width and UDim2.new(0, props.width, 0, props.height or 26)
      or UDim2.new(1, 0, 0, props.height or 26),
    Position = props.pos,
    Parent = parent,
  })
  mk(b, "UICorner", { CornerRadius = UDim.new(0, 6) })
  if props.hover then
    b.MouseEnter:Connect(function()
      TweenService:Create(b, TweenInfo.new(0.12), { BackgroundColor3 = props.hover }):Play()
    end)
    b.MouseLeave:Connect(function()
      TweenService:Create(b, TweenInfo.new(0.12), { BackgroundColor3 = props.bg or TH.panel_alt }):Play()
    end)
  end
  return b
end

local function make_toggle(parent, props)
  local row = mk(parent, "Frame", {
    Size = UDim2.new(1, 0, 0, props.height or 30),
    Position = props.pos,
    BackgroundTransparency = 1,
  })
  mk(row, "TextLabel", {
    Size = UDim2.new(1, -60, 0, 14),
    Position = UDim2.new(0, 0, 0, 2),
    BackgroundTransparency = 1,
    Font = FONT_B, TextSize = 12, TextColor3 = TH.text,
    TextXAlignment = Enum.TextXAlignment.Left,
    Text = props.text or "",
  })
  if props.subtext then
    mk(row, "TextLabel", {
      Size = UDim2.new(1, -60, 0, 10),
      Position = UDim2.new(0, 0, 0, 16),
      BackgroundTransparency = 1,
      Font = FONT, TextSize = 9, TextColor3 = TH.text_muted,
      TextXAlignment = Enum.TextXAlignment.Left,
      Text = props.subtext,
    })
  end
  local btn = make_button(row, {
    text = "OFF", width = 52, height = 20,
    bg = TH.panel_alt, color = TH.text_dim,
    pos = UDim2.new(1, -52, 0, 4),
  })
  local state = props.initial or false
  local function paint(v)
    state = v
    btn.Text = v and "ON" or "OFF"
    btn.BackgroundColor3 = v and TH.ok_dark or TH.panel_alt
    btn.TextColor3 = v and TH.ok or TH.text_dim
  end
  paint(state)
  btn.MouseButton1Click:Connect(function()
    paint(not state)
    if props.on_change then props.on_change(state) end
  end)
end

local function make_section(parent, text, y)
  return mk(parent, "TextLabel", {
    Size = UDim2.new(1, 0, 0, 14),
    Position = UDim2.new(0, 0, 0, y),
    BackgroundTransparency = 1,
    Font = FONT_B, TextSize = 10, TextColor3 = TH.accent,
    TextXAlignment = Enum.TextXAlignment.Left,
    Text = string.upper(text),
  })
end

local function make_input(parent, props)
  local row = mk(parent, "Frame", {
    Size = UDim2.new(1, 0, 0, props.height or 26),
    Position = props.pos,
    BackgroundTransparency = 1,
  })
  mk(row, "TextLabel", {
    Size = UDim2.new(0.55, 0, 1, 0),
    BackgroundTransparency = 1,
    Font = FONT, TextSize = 11, TextColor3 = TH.text,
    TextXAlignment = Enum.TextXAlignment.Left,
    Text = props.label or "",
  })
  local box = mk(row, "TextBox", {
    Size = UDim2.new(0.4, 0, 0, 22),
    Position = UDim2.new(0.55, 0, 0.5, 0),
    AnchorPoint = Vector2.new(0, 0.5),
    BackgroundColor3 = TH.bg, BorderSizePixel = 0,
    Font = FONT_C, TextSize = 12, TextColor3 = TH.text,
    PlaceholderText = props.placeholder or "",
    PlaceholderColor3 = TH.text_muted,
    Text = props.default or "",
    ClearTextOnFocus = false,
  })
  mk(box, "UICorner", { CornerRadius = UDim.new(0, 5) })
  stroke(box, TH.stroke)
  box.FocusLost:Connect(function()
    if props.on_change then props.on_change(box.Text) end
  end)
  return box
end

