--==================== refresh
local function refresh_log()
  if not Ui.log_label then return end
  pcall(function() Ui.log_label.Text = table.concat(LogLines, "\n") end)
  task.defer(function()
    pcall(function()
      if not (Ui.log_label and Ui.log_frame) then return end
      local h = math.max(Ui.log_label.TextBounds.Y + 12, Ui.log_frame.AbsoluteSize.Y)
      Ui.log_frame.CanvasSize = UDim2.new(0, 0, 0, h)
      Ui.log_frame.CanvasPosition = Vector2.new(0, math.max(0, h - Ui.log_frame.AbsoluteSize.Y))
    end)
  end)
end

local function refresh_animal_list()
  if not Ui.animal_list then return end
  for _, c in ipairs(Ui.animal_list:GetChildren()) do
    if c:IsA("TextLabel") then c:Destroy() end
  end
  local items = list_animals()
  for i = 1, math.min(#items, 30) do
    local it, inf = items[i], items[i].info
    local parts = {}
    if inf.rarity then table.insert(parts, inf.rarity) end
    if inf.mutation then table.insert(parts, "[" .. inf.mutation .. "]") end
    if inf.size then table.insert(parts, "<" .. inf.size .. ">") end
    table.insert(parts, "s=" .. string.format("%.1f", inf.score))
    local row = mk(Ui.animal_list, "TextLabel", {
      Size = UDim2.new(1, -12, 0, 18),
      Position = UDim2.new(0, 6, 0, (i - 1) * 20 + 4),
      BackgroundTransparency = 1, Font = FONT_C, TextSize = 10,
      TextColor3 = TH.text_dim, TextXAlignment = Enum.TextXAlignment.Left,
      Text = string.format("%-13s %s", it.tool.Name:sub(1, 13), table.concat(parts, " ")),
    })
    if inf.mutation and MUT_COLOR[inf.mutation] then
      row.TextColor3 = MUT_COLOR[inf.mutation]
    elseif inf.rarity and RARITY_COLOR[inf.rarity] then
      row.TextColor3 = RARITY_COLOR[inf.rarity]
    end
  end
  Ui.animal_list.CanvasSize = UDim2.new(0, 0, 0, math.max(#items * 20 + 8, 40))
  if Ui.animal_count_label then
    Ui.animal_count_label.Text = string.format("%d animals · tối đa 30", #items)
  end
end

local function refresh_stats()
  if Ui.home_balo then Ui.home_balo.Text = "balo: " .. count_animals() .. " thú" end
  if Ui.home_food then
    local f = State.food_id or scan_best_food()
    Ui.home_food.Text = "food: " .. f .. " (" .. (FOOD_NAMES[f] or "?") .. ")"
  end
  if Ui.home_mode then
    Ui.home_mode.Text = "mode: " .. State.throw_mode .. " · " .. (MODE_SHORT[State.throw_mode] or "?")
  end
  if Ui.money_label then
    local m, lv = get_money(), get_level()
    local p = {}
    if m then table.insert(p, "money: $" .. fmt_money(m)) end
    if lv then table.insert(p, "lv " .. tostring(lv)) end
    Ui.money_label.Text = #p > 0 and table.concat(p, " · ") or "money: --"
  end
  if Ui.status_label then
    local lines = {}
    local function st(name, on) if on then table.insert(lines, "● " .. name) end end
    st("throw", State.auto_throw)
    st("train", State.auto_train)
    st("place", State.auto_place)
    st("sell", State.auto_sell)
    st("equip", State.auto_equip)
    st("claim", State.auto_claim)
    st("offline", State.auto_offline)
    st("fence", State.auto_fence)
    if State.testing then
      Ui.status_label.TextColor3 = TH.warn
      Ui.status_label.Text = "ĐANG TEST MODES\n" .. #lines .. " chức năng bật"
    elseif State.running then
      Ui.status_label.TextColor3 = TH.ok
      Ui.status_label.Text = "ĐANG CHẠY (" .. #lines .. ")\n" ..
        (#lines > 0 and table.concat(lines, "  ") or "bật toggle để hoạt động")
    else
      Ui.status_label.TextColor3 = TH.text_muted
      Ui.status_label.Text = "STOP · nhấn START"
    end
  end
  if Ui.dot then
    Ui.dot.BackgroundColor3 = State.running and TH.ok or TH.danger
  end
end

task.spawn(function()
  while true do
    task.wait(2)
    pcall(refresh_stats)
    if Ui.active_tab == "animals" then pcall(refresh_animal_list) end
  end
end)

--==================== tab switching
local function switch_tab(id)
  Ui.active_tab = id
  for tid, frame in pairs(Ui.tabs) do frame.Visible = (tid == id) end
  for tid, btn in pairs(Ui.tab_buttons) do
    local a = (tid == id)
    btn.BackgroundColor3 = a and TH.accent_dark or TH.panel_alt
    btn.TextColor3 = a and TH.accent or TH.text_dim
  end
  if id == "animals" then pcall(refresh_animal_list) end
  if id == "log" then pcall(refresh_log) end
end

