--==================== test modes
local function test_modes()
  if State.testing then return end
  State.testing = true
  local saved = State.auto_throw
  State.auto_throw = false
  log("=== TEST MODES 1-7 ===")
  local results = {}
  for mode = 1, 7 do
    State.throw_mode = mode
    local before = count_animals()
    log("mode " .. mode .. ": " .. MODE_SHORT[mode])
    for i = 1, 3 do
      do_throw(); task.wait(2.1)
    end
    local diff = count_animals() - before
    results[mode] = diff
    log("  → +" .. diff)
  end
  log("=== KẾT QUẢ ===")
  local winner, best = nil, 0
  for mode, diff in pairs(results) do
    if diff > best then winner = mode; best = diff end
  end
  if winner then
    State.throw_mode = winner
    log("MODE " .. winner .. " WORK (+" .. best .. ") — đã chọn")
    notify("mode work: " .. winner)
  else
    log("CẢ 7 MODE FAIL — cần spy args")
    notify("cả 7 mode fail")
  end
  State.testing = false
  State.auto_throw = saved
end

--==================== scheduler
local function scheduler()
  log("scheduler started")
  while State.running do
    local t = os.clock()
    local N = State.next
    if State.auto_claim and t >= N.claim then
      N.claim = t + CONFIG.CLAIM_DELAY; task.spawn(act_claim)
    end
    if State.auto_offline and t >= N.offline then
      N.offline = t + CONFIG.OFFLINE_DELAY; task.spawn(act_offline)
    end
    if State.auto_equip and t >= N.equip then
      N.equip = t + CONFIG.EQUIP_DELAY; task.spawn(act_equip)
    end
    if State.auto_sell and t >= N.sell then
      N.sell = t + CONFIG.SELL_DELAY; task.spawn(act_sell)
    end
    if State.auto_place and t >= N.place then
      N.place = t + CONFIG.PLACE_DELAY; task.spawn(act_place)
    end
    if State.auto_fence and t >= N.cycle then
      N.cycle = t + 60; task.spawn(act_fence)
    end
    if State.auto_train and t >= N.train then
      N.train = t + CONFIG.TRAIN_TAP; task.spawn(train_tap)
    end
    if State.auto_train and State.training_started and t >= (N.train_cycle or 0) then
      N.train_cycle = t + CONFIG.TRAIN_CYCLE
      task.spawn(function()
        train_stop(); task.wait(1.5)
        if State.auto_train then train_tap() end
      end)
    end
    if State.auto_throw and t >= N.throw and not State.testing then
      local jitter = 1 + (math.random() * 2 - 1) * CONFIG.THROW_JITTER
      N.throw = t + CONFIG.THROW_DELAY * jitter
      if math.random() > CONFIG.THROW_SKIP then
        task.spawn(function()
          if math.random() < 0.05 then apply_power() end
          do_throw()
        end)
      end
    end
    task.wait(0.1)
  end
  log("scheduler stopped")
end

local function start_all()
  if State.running then return end
  if not State.food_id then
    State.food_id = scan_best_food()
    log("food: Food" .. State.food_id)
  end
  State.running = true
  task.spawn(scheduler)
  log("=== START ===")
end

local function stop_all()
  if not State.running then return end
  State.running = false
  pcall(train_stop)
  log("=== STOP ===")
end

--==================== boost watcher
local function install_boost_watcher()
  local re = RS:FindFirstChild("RemoteEvents")
  if not re then return end
  local names = { "Shop_Announce", "Notify", "AdminAbuse_Gift", "AdminAbuse_Vote",
    "Throw_Revealed", "Throw_SuperGranted", "Training_Bonus" }
  for _, n in ipairs(names) do
    local ev = re:FindFirstChild(n)
    if ev and ev:IsA("RemoteEvent") then
      ev.OnClientEvent:Connect(function(...)
        local args = { ... }
        local txt = ""
        for _, a in ipairs(args) do
          if type(a) == "string" then txt = txt .. " " .. a end
        end
        local low = txt:lower()
        if low:find("luck") or low:find("boost")
          or low:find("2x") or low:find("4x") or low:find("8x") or low:find("16x") then
          State.boost_status = low:sub(1, 40)
          log("BOOST: " .. txt:sub(1, 120))
          notify("boost: " .. txt:sub(1, 80))
        end
        if n == "Throw_Revealed" and args[1] then
          local s = tostring(args[1])
          if s:lower():find("rainbow") or s:lower():find("ruby") or s:lower():find("diamond") then
            log("RARE DROP: " .. s:sub(1, 120))
          end
        end
      end)
    end
  end
end

