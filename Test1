local function fmt_money(n)
  if not n then return "?" end
  n = tonumber(n) or 0
  local s = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }
  local i = 1
  while n >= 1000 and i < #s do n = n / 1000; i = i + 1 end
  if i == 1 then return string.format("%.0f", n) end
  return string.format("%.2f%s", n, s[i])
end

local function scan_best_food()
  if CONFIG.FOOD_ID ~= "auto" then return tonumber(CONFIG.FOOD_ID) or 1 end
  local bp = LP:FindFirstChild("Backpack")
  local best = 1
  if bp then
    for _, t in ipairs(bp:GetChildren()) do
      if t:IsA("Tool") then
        local fid
        pcall(function() fid = t:GetAttribute("FoodId") or t:GetAttribute("Id") end)
        if fid and fid >= 1 and fid <= 50 and fid > best then best = fid end
      end
    end
  end
  return best
end

local function is_food_tool(t)
  local is_food = false
  pcall(function() is_food = t:GetAttribute("FoodId") or t:GetAttribute("IsFood") end)
  if is_food then return true end
  for _, name in pairs(FOOD_NAMES) do
    if t.Name:find(name, 1, true) then return true end
  end
  return false
end

local function scan_animal(tool)
  local info = { mutation = nil, size = nil, rarity = nil, score = 1, income = nil }
  local attrs
  pcall(function() attrs = tool:GetAttributes() end)
  if attrs then
    for k, v in pairs(attrs) do
      local kl = string.lower(k)
      if type(v) == "string" then
        if MUTATIONS[v] then info.mutation = v
        elseif SIZES[v] then info.size = v
        elseif RARITY_SCORE[v] then info.rarity = v
        elseif kl:find("mutation") and MUTATIONS[v] then info.mutation = v
        elseif kl:find("size") and SIZES[v] then info.size = v
        elseif kl:find("rarity") and RARITY_SCORE[v] then info.rarity = v
        end
      elseif type(v) == "number" then
        if kl:find("income") or kl:find("persec") or kl:find("value") or kl == "money" then
          info.income = v
        end
      end
    end
  end
  local base = (info.rarity and RARITY_SCORE[info.rarity]) or 1
  local mm = (info.mutation and MUT_MULT[info.mutation]) or 1
  local sm = (info.size and SIZE_MULT[info.size]) or 1
  info.score = info.income or (base * mm * sm)
  return info
end

local function list_animals()
  local bp = LP:FindFirstChild("Backpack")
  local out = {}
  if not bp then return out end
  for _, item in ipairs(bp:GetChildren()) do
    if item:IsA("Tool") and not is_food_tool(item) then
      table.insert(out, { tool = item, info = scan_animal(item) })
    end
  end
  table.sort(out, function(a, b) return a.info.score > b.info.score end)
  return out
end

local function count_animals() return #list_animals() end

