--==================== throw
local function inv(remote, ...)
  if not remote then return false end
  return (pcall(remote.InvokeServer, remote, ...))
end

local function do_throw()
  local mode = State.throw_mode
  local food = State.food_id or 1
  if mode == 1 then
    inv(R.Throw_Start); task.wait(0.25)
    inv(R.Throw_Resolve); task.wait(0.25)
    inv(R.Throw_Complete)
  elseif mode == 2 then
    inv(R.Throw_Start, food); task.wait(0.25)
    inv(R.Throw_Resolve, food, 1.0); task.wait(0.25)
    inv(R.Throw_Complete, food)
  elseif mode == 3 then
    inv(R.Throw_Start, food); task.wait(0.25)
    inv(R.Throw_Resolve, food, 20); task.wait(0.25)
    inv(R.Throw_Complete, food)
  elseif mode == 4 then
    inv(R.Throw_Start, food); task.wait(0.8)
    inv(R.Throw_Resolve, food); task.wait(0.25)
    inv(R.Throw_Complete, food)
  elseif mode == 5 then
    inv(R.Throw_Start, food); task.wait(0.25)
    inv(R.Throw_Resolve, 1.0); task.wait(0.25)
    inv(R.Throw_Complete)
  elseif mode == 6 then
    inv(R.Throw_Start, food); task.wait(1.2)
    inv(R.Throw_Resolve, 20); task.wait(0.25)
    inv(R.Throw_Complete, food)
  elseif mode == 7 then
    inv(R.Throw_Start, food)
  end
  return true
end

local function apply_power()
  if CONFIG.THROW_POWER == "max" then return end
  local n = tonumber(CONFIG.THROW_POWER)
  if not n then return end
  if R.Player_SetThrowPower then
    pcall(R.Player_SetThrowPower.InvokeServer, R.Player_SetThrowPower, n)
  end
end

