local SESSION = { key = "local", ok = false }
if CONFIG.ENABLE_AUTH then
  local HTTP_FN = (syn and syn.request) or (http and http.request) or http_request or request
  if not HTTP_FN then
    log("auth: executor không hỗ trợ http"); getgenv().nyx_loaded = false; return
  end

  local function get_hwid()
    local ok, v = pcall(function() return gethwid() end)
    if ok and type(v) == "string" and #v > 2 then return v end
    ok, v = pcall(function() return game:GetService("RbxAnalyticsService"):GetClientId() end)
    if ok and type(v) == "string" then return v end
    return "uid" .. tostring(LP.UserId)
  end

  local function read_key()
    if not (readfile and isfile) then return nil end
    local ok, has = pcall(isfile, CONFIG.KEY_FILE)
    if not ok or not has then return nil end
    local ok2, c = pcall(readfile, CONFIG.KEY_FILE)
    if not ok2 or type(c) ~= "string" then return nil end
    local k = c:gsub("%s+", ""); if #k >= 6 then return k end
  end

  local function api_post(path, body)
    local payload = (function() local ok, v = pcall(function() return HS:JSONEncode(body) end); return ok and v or nil end)()
    if not payload then return nil, "encode" end
    local ok2, res = pcall(HTTP_FN, { Url = CONFIG.API .. path, Method = "POST",
      Headers = { ["content-type"] = "application/json" }, Body = payload })
    if not ok2 or type(res) ~= "table" or not res.Body then return nil, "network" end
    local ok3, data = pcall(function() return HS:JSONDecode(res.Body) end)
    if not ok3 or type(data) ~= "table" then return nil, "decode" end
    return data
  end

  local key = read_key()
  if not key then
    log("auth: chưa có key, nhập vào nyx_key.txt rồi chạy lại")
    getgenv().nyx_loaded = false; return
  end
  local data, err = api_post("/v1/auth", { key = key, hwid = get_hwid() })
  if not (data and (data.ok or data.err == "no_payload")) then
    log("auth fail: " .. tostring(data and data.err or err))
    getgenv().nyx_loaded = false; return
  end
  SESSION = { key = key, ok = true, hwid = get_hwid() }
  log("auth ok: " .. key:sub(1,4) .. "…" .. key:sub(-4))
else
  log("auth: disabled (dev)")
end

