  y = y + 32
  make_input(parent, {
    label = "Throw Power (studs)", default = "max", placeholder = "max",
    pos = UDim2.new(0, 0, 0, y),
    on_change = function(v)
      local n = tonumber(v)
      if n and n > 0 then CONFIG.THROW_POWER = n; log("power: " .. n)
      else CONFIG.THROW_POWER = "max"; log("power: max") end
    end,
