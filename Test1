local function act_sell()
  if not R.Plot_SellAnimal then return end
  local items = list_animals()
  local sold, kept = 0, 0
  for _, it in ipairs(items) do
    local inf = it.info
    local is_trash = inf.rarity and State.sell_rarity[inf.rarity]
    local keep = false
    if CONFIG.KEEP_MUTATION and inf.mutation then keep = true end
    if CONFIG.KEEP_SIZE and inf.size then keep = true end
    if not keep and is_trash then
      local ok = pcall(R.Plot_SellAnimal.InvokeServer, R.Plot_SellAnimal, it.tool)
      if not ok then pcall(R.Plot_SellAnimal.InvokeServer, R.Plot_SellAnimal, it.tool.Name) end
      if ok then sold = sold + 1 end
      task.wait(0.08)
    else
      kept = kept + 1
    end
  end
  if sold > 0 then log("đã bán " .. sold .. " · giữ " .. kept) end
  return sold
end

local function act_place()
  if not R.Plot_PlaceAnimal then return end
  local items = list_animals()
  if #items == 0 then return end
  local placed = 0
  for i = 1, math.min(#items, 3) do
    local ok = pcall(R.Plot_PlaceAnimal.InvokeServer, R.Plot_PlaceAnimal, items[i].tool)
    if not ok then
      pcall(R.Plot_PlaceAnimal.InvokeServer, R.Plot_PlaceAnimal, items[i].tool.Name)
    end
    if ok then placed = placed + 1 end
    task.wait(0.15)
  end
  if placed > 0 then log("đặt " .. placed .. " thú lên base") end
  return placed
end

local function act_fence()
