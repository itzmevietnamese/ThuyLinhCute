local KEY = "GG-anhyeuem"
-- ============================================================

local HttpService = game:GetService("HttpService")
local KEY_URL = "https://ryohub.com/api"
local KEY_FILE = "ryohubkey.txt"
local OLD_KEY_FILE = "gtdkey.txt"
local LP = game.Players.LocalPlayer
while not LP do task.wait() LP = game.Players.LocalPlayer end

local LUARMOR = {
	["7703614594"] = "8d11fac52ad6ac04965c6428a481f7e8",
	["10762636904"] = "87382963cda940061b4c45950491a70d",
	["3183403065"] = "4bc3dc92851c70348a963d6154fde5ed",
	["4778845442"] = "7bc0ff71c90839b081be90ae739ed862",
}

local function usable(b) return type(b) == "string" and #b > 0 and not b:match("^%s*<") end
local function httpGetOnce(url)
	local req = (syn and syn.request) or http_request or request or (http and http.request) or (fluxus and fluxus.request)
	if req then
		local ok, r = pcall(req, {Url = url, Method = "GET"})
		if ok and type(r) == "table" and usable(r.Body) then return r.Body end
	end
	local ok, body = pcall(function() return game:HttpGet(url) end)
	if ok and usable(body) then return body end
	return nil
end
local function httpGet(url)
	for i = 1, 3 do
		local b = httpGetOnce(url)
		if b then return b end
		if i < 3 then task.wait(i * 1.5) end
	end
	return nil
end
local function urlEncode(str)
	return (tostring(str):gsub("[^%w%-_%.~]", function(c) return string.format("%%%02X", string.byte(c)) end))
end
local function clean(k)
	k = (tostring(k or ""):gsub("%s", ""))
	if k:upper():sub(1, 3) == "GG-" then k = k:upper() end
	return k
end
local function isRyoKey(k) return k:sub(1, 3) == "GG-" end
local lrmApi
local function lrm(scriptId)
	for i = 1, 3 do
		if lrmApi then break end
		local ok, api = pcall(function() return loadstring(game:HttpGet("https://sdkapi-public.luarmor.net/library.lua"))() end)
		if ok and type(api) == "table" then lrmApi = api elseif i < 3 then task.wait(i * 1.5) end
	end
	if lrmApi then lrmApi.script_id = scriptId end
	return lrmApi
end

local function who(key)
	return "&key=" .. urlEncode(key) .. "&uid=" .. tostring(LP.UserId) .. "&game=" .. tostring(game.GameId) .. "&place=" .. tostring(game.PlaceId)
end

local function fetchScript(key)
	if not isRyoKey(key) then
		local sid = LUARMOR[tostring(game.GameId)]
		if sid then
			local api = lrm(sid)
			if api then
				return function()
					script_key = key
					pcall(function() getgenv().script_key = key end)
					api.load_script()
				end
			end
		end
	end
	local err = "Can't reach the key server."
	for i = 1, 2 do
		local body = httpGet(KEY_URL .. "?s=src" .. who(key))
		if not body then return nil, err end
		if body:sub(1, 1) == "{" then
			local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
			if ok and type(data) == "table" then
				return nil, tostring(data.message or "Refused.")
			end
			return nil, "Bad response from server."
		end
		local fn, e = loadstring(body)
		if fn then return fn end
		err = "Failed to load: " .. tostring(e)
		task.wait(2)
	end
	return nil, err
end

local function start(key, fn)
	pcall(function() if writefile then writefile(KEY_FILE, key) end end)
	if isRyoKey(key) then pcall(function() if writefile then writefile(OLD_KEY_FILE, key) end end) end
	local env = getgenv and getgenv() or _G
	env.__RYO_KEY = key
	if isRyoKey(key) then env.__GTD_KEY = key end
	task.spawn(fn)
end

local key = clean(KEY)
if key == "" then
	warn("[Ryo Hub] No key set.")
	return
end

local fn, err = fetchScript(key)
if fn then
	start(key, fn)
else
	warn("[Ryo Hub] " .. tostring(err))
end
