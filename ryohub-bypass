	input.ClearTextOnFocus = false
	input.BorderSizePixel = 0
	Instance.new("UICorner", input).CornerRadius = UDim.new(0, 8)
	local btn = Instance.new("TextButton", box)
	btn.Size = UDim2.new(1, -40, 0, 34)
	btn.Position = UDim2.new(0, 20, 0, 124)
	btn.BackgroundColor3 = Color3.fromRGB(220, 30, 30)
	btn.AutoButtonColor = false
	btn.Text = "CHECK KEY"
	btn.TextColor3 = Color3.new(1, 1, 1)
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 13
	btn.BorderSizePixel = 0
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
	local msg = lbl(firstMsg or "", 168, 12, Enum.Font.GothamMedium, Color3.fromRGB(255, 140, 150))
	msg.Size = UDim2.new(1, -40, 0, 40)
	if FREE_KEY_URL ~= "" then
		btn.Size = UDim2.new(0.5, -25, 0, 34)
		local fb = Instance.new("TextButton", box)
		fb.Size = UDim2.new(0.5, -25, 0, 34)
		fb.Position = UDim2.new(0.5, 5, 0, 124)
		fb.BackgroundColor3 = Color3.fromRGB(40, 22, 22)
		fb.AutoButtonColor = false
		fb.Text = "GET KEY"
		fb.TextColor3 = Color3.fromRGB(243, 236, 236)
		fb.Font = Enum.Font.GothamBold
		fb.TextSize = 13
		fb.BorderSizePixel = 0
		Instance.new("UICorner", fb).CornerRadius = UDim.new(0, 8)
		local fs = Instance.new("UIStroke", fb)
		fs.Color = Color3.fromRGB(255, 48, 48)
		fs.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		fb.MouseButton1Click:Connect(function()
			local copied = pcall(function() setclipboard(FREE_KEY_URL) end)
			fb.Text = copied and "LINK COPIED" or "GET KEY"
			msg.TextColor3 = Color3.fromRGB(168, 150, 150)
			msg.Text = copied and "Link copied! Open it in your browser, pick Linkvertise or Lootlabs, then paste your key here." or ("Open this link: " .. FREE_KEY_URL)
		end)
	end


	local busy = false
	local function try()
		if busy then return end
		busy = true
		btn.Text = "CHECKING..."
		msg.TextColor3 = Color3.fromRGB(168, 150, 150)
		msg.Text = ""
		local key = clean(input.Text)
		local ok, info = checkKey(key)
		if ok then
			btn.Text = "LOADING..."
			local fn, err = fetchScript(key)
			if fn then
				sg:Destroy()
				start(key, info, fn)
				return
			end
			info = err
		end
		msg.TextColor3 = Color3.fromRGB(255, 140, 150)
		msg.Text = info
		btn.Text = "CHECK KEY"
		busy = false
	end
	btn.MouseButton1Click:Connect(try)
	input.FocusLost:Connect(function(enter) if enter then try() end end)
	if savedNet then
		msg.Text = (firstMsg or "") .. " Retrying by itself..."
		task.spawn(function()
			for i = 1, 40 do
				task.wait(20)
				if not sg.Parent then return end
				if not busy and clean(input.Text) == saved then
					busy = true
					local done, info, code = trySaved()
					if done then pcall(function() sg:Destroy() end) return end
					busy = false
					msg.TextColor3 = Color3.fromRGB(255, 140, 150)
					msg.Text = tostring(info) .. (code == "NET" and " Retrying by itself..." or "")
					if code ~= "NET" then return end
				end
			end
		end)
	end
end
